5, "margin_plain_minus_spec": -1.032, "top1": " m", "top2_margin": 1.032}, "bfloat16": {"logit_plain_tok": 30.25, "logit_spec_tok": 31.375, "margin_plain_minus_spec": -1.125, "top1": " m", "top2_margin": 1.125}, "hf_fp32_matches": "spec"}, {"clip_id": "mls_fr/test/1406_1028_000043", "pos": 15, "tok_plain": " et", "tok_spec": ",", "hf_fp32_greedy_text": "Le marchand s'en retourna auprès de sa femme et de ses enfants et passa tranquillement avec eux le reste de ses jours. Messire, ajouta Cheyrazade, quelque beaux que soient les contes que j'ai racontés", "float32": {"logit_plain_tok": 38.089, "logit_spec_tok": 37.133, "margin_plain_minus_spec": 0.956, "top1": " et", "top2_margin": 0.956}, "bfloat16": {"logit_plain_tok": 38.0, "logit_spec_tok": 37.25, "margin_plain_minus_spec": 0.75, "top1": " et", "top2_margin": 0.75}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_fr/test/9834_9697_000089", "pos": 26, "tok_plain": " zad", "tok_spec": " Had", "hf_fp32_greedy_text": "Le plus saut des Chaldéens et par tant le plus fanatique, cet homme aurait fait tremper les zadig pour la plus grande gloire du Soleil et en aurait récité le bréviaire de Zoroastre d'un ton plus satis", "float32": {"logit_plain_tok": 23.272, "logit_spec_tok": 23.118, "margin_plain_minus_spec": 0.153, "top1": " zad", "top2_margin": 0.153}, "bfloat16": {"logit_plain_tok": 23.625, "logit_spec_tok": 23.375, "margin_plain_minus_spec": 0.25, "top1": " zad", "top2_margin": 0.25}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_de/test/3052_2124_000020", "pos": 37, "tok_plain": "sum", "tok_spec": "c", "hf_fp32_greedy_text": "Sie wollte zum Sprechen, aber sie fand keine Worte. Nur ihr Blick dankte ihm. Auf Wiedersehen. Bereits vierundzwanzig Stunden hatte Xmas auf der Polinsel zugebracht, ohne dass die in Aussicht genommen", "float32": {"logit_plain_tok": 22.864, "logit_spec_tok": 22.863, "margin_plain_minus_spec": 0.001, "top1": "sum", "top2_margin": 0.001}, "bfloat16": {"logit_plain_tok": 22.75, "logit_spec_tok": 22.875, "margin_plain_minus_spec": -0.125, "top1": "c", "top2_margin": 0.125}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_de/test/3588_1614_000112", "pos": 0, "tok_plain": "I", "tok_spec": "Is", "hf_fp32_greedy_text": "I skiftet, vi er lyden mus, da den afgøres befiel det hjemvej. Først ziben månaten varer for flossen, og når da vi er irgent et sted fra landet gehørt har den.", "float32": {"logit_plain_tok": 27.161, "logit_spec_tok": 27.064, "margin_plain_minus_spec": 0.097, "top1": "I", "top2_margin": 0.097}, "bfloat16": {"logit_plain_tok": 27.25, "logit_spec_tok": 27.125, "margin_plain_minus_spec": 0.125, "top1": "I", "top2_margin": 0.125}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_de/test/7406_6765_000021", "pos": 29, "tok_plain": " mehr", "tok_spec": "m", "hf_fp32_greedy_text": "Verlässt du mich nicht, so verlasse ich dich auch nicht. So sprach der Fundevogel nun und nimmermehr. Da sprach Länchen: Ich will es dir nur sagen. Die Sanne schleppte gestern Abend so viel Eimer Wass", "float32": {"logit_plain_tok": 33.296, "logit_spec_tok": 33.162, "margin_plain_minus_spec": 0.134, "top1": " mehr", "top2_margin": 0.134}, "bfloat16": {"logit_plain_tok": 33.25, "logit_spec_tok": 33.0, "margin_plain_minus_spec": 0.25, "top1": " mehr", "top2_margin": 0.25}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_es/test/11168_11991_000036", "pos": 27, "tok_plain": " era", "tok_spec": ".", "hf_fp32_greedy_text": "tanto como la suya propia y la comunicación diaria que con ellos mantenía había llegado a constituir un hábito era muy triste ver abandonados aquellos parajes y más aún considerar que pasaban a otras ", "float32": {"logit_plain_tok": 38.679, "logit_spec_tok": 37.918, "margin_plain_minus_spec": 0.761, "top1": " era", "top2_margin": 0.761}, "bfloat16": {"logit_plain_tok": 38.25, "logit_spec_tok": 37.75, "margin_plain_minus_spec": 0.5, "top1": " era", "top2_margin": 0.5}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_es/test/11266_10604_000008", "pos": 42, "tok_plain": "í", "tok_spec": "ir", "hf_fp32_greedy_text": "El quejime junto a la tumba de su dios, de su amo, ni morir sabe. Tú, al morir, presentías vagamente vivir en mi memoria, no morirte del todo.", "float32": {"logit_plain_tok": 32.244, "logit_spec_tok": 32.411, "margin_plain_minus_spec": -0.167, "top1": "ir", "top2_margin": 0.167}, "bfloat16": {"logit_plain_tok": 32.25, "logit_spec_tok": 32.25, "margin_plain_minus_spec": 0.0, "top1": "í", "top2_margin": 0.0}, "hf_fp32_matches": "spec"}, {"clip_id": "mls_es/test/1448_567_000041", "pos": 8, "tok_plain": " libre", "tok_spec": " lib", "hf_fp32_greedy_text": "Oh quien de tus deseos y libreá alma y cuerpo adornara, y del famoso caballero que hiciste venturoso mirara alguna desigual pelea. Oh quien tan castamente se escapara del señor Amadís como tú hiciste,", "float32": {"logit_plain_tok": 31.32, "logit_spec_tok": 31.285, "margin_plain_minus_spec": 0.034, "top1": " libre", "top2_margin": 0.034}, "bfloat16": {"logit_plain_tok": 31.25, "logit_spec_tok": 31.125, "margin_plain_minus_spec": 0.125, "top1": " libre", "top2_margin": 0.125}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_es/test/3471_1378_000051", "pos": 14, "tok_plain": " y", "tok_spec": ",", "hf_fp32_greedy_text": "Hasta agora no he tocado derecho ni llevado cohecho y no puedo pensar en qué va esto, porque aquí me han dicho que los gobernadores que a esta isla suelen venir.", "float32": {"logit_plain_tok": 43.736, "logit_spec_tok": 42.84, "margin_plain_minus_spec": 0.896, "top1": " y", "top2_margin": 0.896}, "bfloat16": {"logit_plain_tok": 43.75, "logit_spec_tok": 42.75, "margin_plain_minus_spec": 1.0, "top1": " y", "top2_margin": 1.0}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_es/test/676_567_000041", "pos": 57, "tok_plain": " pasar", "tok_spec": "is", "hf_fp32_greedy_text": "suceso y si tiene parientes a quien dar noticia de su desgracia esto es señores lo que sabré deciros de lo que me habéis preguntado y entended que el dueño de las prendas que hallasteis es el mismo qu", "float32": {"logit_plain_tok": 29.039, "logit_spec_tok": 29.047, "margin_plain_minus_spec": -0.007, "top1": "is", "top2_margin": 0.007}, "bfloat16": {"logit_plain_tok": 28.875, "logit_spec_tok": 29.0, "margin_plain_minus_spec": -0.125, "top1": "is", "top2_margin": 0.125}, "hf_fp32_matches": "spec"}, {"clip_id": "mls_es/test/7510_7613_000037", "pos": 2, "tok_plain": "é", "tok_spec": "que", "hf_fp32_greedy_text": "Atruéque de ser roído en diez horas hasta el esqueleto. Permanecen en el lugar uno, dos, hasta cinco días, según su riqueza en insectos, carne y grasa. Una vez devorado todo, se van.", "float32": {"logit_plain_tok": 31.252, "logit_spec_tok": 27.223, "margin_plain_minus_spec": 4.029, "top1": "é", "top2_margin": 4.029}, "bfloat16": {"logit_plain_tok": 31.375, "logit_spec_tok": 27.125, "margin_plain_minus_spec": 4.25, "top1": "é", "top2_margin": 4.25}, "hf_fp32_matches": "plain"}, {"clip_id": "mls_es/test/97_567_000009", "pos": 15, "tok_plain": " y", "tok_spec": ",", "hf_fp32_greedy_text": "En esta maldita cama se acostó Don Quijote y luego la ventera y su hija le emplastaron de arriba abajo, alumbrándoles maritornes, que así se llamaba la asturiana.", "float32": {"logit_plain_tok": 39.729, "logit_spec_tok": 38.474, "margin_plain_minus_spec": 1.254, "top1": " y", "top2_margin": 1.254}, "bfloat16": {"logit_plain_tok": 39.75, "logit_spec_tok": 38.75, "margin_plain_minus_spec": 1.0, "top1": " y", "top2_margin": 1.0}, "hf_fp32_matches": "plain"}, {"clip_id": "voxpopuli/test/20090324-0900-PLENARY-7-en_20090324-15:32:59_1", "pos": 18, "tok_plain": " here", "tok_spec": " in", "hf_fp32_greedy_text": "In the name of the European Parliament, I want to thank you for this very remarkable speech in the European Parliament. And now it is a pleasure to invite the President of the European Commission, Jos", "float32": {"logit_plain_tok": 33.144, "logit_spec_tok": 33.528, "margin_plain_minus_spec": -0.385, "top1": " in", "top2_margin": 0.385}, "bfloat16": {"logit_plain_tok": 33.25, "logit_spec_tok": 33.5, "margin_plain_minus_spec": -0.25, "top1": " in", "top2_margin": 0.25}, "hf_fp32_matches": "spec"}, {"clip_id": "voxpopuli/test/20140204-0900-PLENARY-13-en_20140204-16:12:10_5", "pos": 4, "tok_plain": ",", "tok_spec": " vulnerable", "hf_fp32_greedy_text": "That means that individual vulnerable member states would again be liable to falling prey to isolation and costly bailouts at their taxpayers' expense. The link between banking and sovereign banks wou", "float32": {"logit_plain_tok": 37.237, "logit_spec_tok": 38.064, "margin_plain_minus_spec": -0.827, "top1": " vulnerable", "top2_margin": 0.827}, "bfloat16": {"logit_plain_tok": 37.25, "logit_spec_tok": 37.75, "margin_plain_minus_spec": -0.5, "top1": " vulnerable", "top2_margin": 0.5}, "hf_fp32_matches": "spec"}, {"clip_id": "voxpopuli/test/20150527-0900-PLENARY-14-en_20150527-21:33:28_2", "pos": 19, "tok_plain": " Memory", "tok_spec": " Mem", "hf_fp32_greedy_text": "One of the leading campaigners for this tremendous change was an 18-year-old young woman called Memory Bander, who started her advocacy on this issue when her own sister was married at the age of 11 t", "float32": {"logit_plain_tok": 27.268, "logit_spec_tok": 26.702, "margin_plain_minus_spec": 0.566, "top1": " Memory", "top2_margin": 0.566}, "bfloat16": {"logit_plain_tok": 27.375, "logit_spec_tok": 26.875, "margin_plain_minus_spec": 0.5, "top1": " Memory", "top2_margin": 0.5}, "hf_fp32_matches": "plain"}, {"clip_id": "voxpopuli/test/20180417-0900-PLENARY-12-en_20180417-15:52:02_1", "pos": 35, "tok_plain": " and", "tok_spec": ",", "hf_fp32_greedy_text": "I believe that building legal avenues and stepping up pledging efforts to resettle those in need is a key aspect in order to tackle the problem. I welcome the Compact on Migration and I appreciate its", "float32": {"logit_plain_tok": 40.094, "logit_spec_tok": 39.224, "margin_plain_minus_spec": 0.87, "top1": " and", "top2_margin": 0.87}, "bfloat16": {"logit_plain_tok": 40.0, "logit_spec_tok": 39.0, "margin_plain_minus_spec": 1.0, "top1": " and", "top2_margin": 1.0}, "hf_fp32_matches": "plain"}, {"clip_id": "cv17/test/common_voice_en_19667009", "pos": 5, "tok_plain": " even", "tok_spec": ",", "hf_fp32_greedy_text": "There, they dance together even after the lights are turned off.", "float32": {"logit_plain_tok": 48.537, "logit_spec_tok": 47.425, "margin_plain_minus_spec": 1.112, "top1": " even", "top2_margin": 1.112}, "bfloat16": {"logit_plain_tok": 48.25, "logit_spec_tok": 47.5, "margin_plain_minus_spec": 0.75, "top1": " even", "top2_margin": 0.75}, "hf_fp32_matches": "plain"}, {"clip_id": "cv17/test/common_voice_en_20409643", "pos": 13, "tok_plain": "ener", "tok_spec": "ana", "hf_fp32_greedy_text": "Joining the Capaccio River, it becomes the Midana River.", "float32": {"logit_plain_tok": 25.139, "logit_spec_tok": 25.113, "margin_plain_minus_spec": 0.027, "top1": "ener", "top2_margin": 0.027}, "bfloat16": {"logit_plain_tok": 25.0, "logit_spec_tok": 25.125, "margin_plain_minus_spec": -0.125, "top1": "ana", "top2_margin": 0.125}, "hf_fp32_matches": "plain"}, {"clip_id": "cv17/test/common_voice_en_24924097", "pos": 5, "tok_plain": "ui", "tok_spec": "uren", "hf_fp32_greedy_text": "It was named after Turen in Italy.", "float32": {"logit_plain_tok": 20.048, "logit_spec_tok": 20.225, "margin_plain_minus_spec": -0.177, "top1": "uren", "top2_margin": 0.177}, "bfloat16": {"logit_plain_tok": 20.0, "logit_spec_tok": 20.0, "margin_plain_minus_spec": 0.0, "top1": "uren", "top2_margin": 0.0}, "hf_fp32_matches": "spec"}, {"clip_id": "cv17/test/common_voice_en_26957542", "pos": 4, "tok_plain": " Bal", "tok_spec": " Kal", "hf_fp32_greedy_text": "It turned out that Kalame was unarmed.", "float32": {"logit_plain_tok": 25.118, "logit_spec_tok": 25.292, "margin_plain_minus_spec": -0.174, "top1": " Kal", "top2_margin": 0.174}, "bfloat16": {"logit_plain_tok": 25.0, "logit_spec_tok": 25.25, "margin_plain_minus_spec": -0.25, "top1": " Kal", "top2_margin": 0.25}, "hf_fp32_matches": "spec"}, {"clip_id": "cv17_zh-CN/test/common_voice_zh-CN_22071224", "pos": 9, "tok_plain": "马", "tok_spec": "玛丽", "hf_fp32_greedy_text": "因威拉米特河的支流玛丽河流经此地而被称为玛丽维尔。", "float32": {"logit_plain_tok": 35.006, "logit_spec_tok": 35.306, "margin_plain_minus_spec": -0.3, "top1": "玛丽", "top2_margin": 0.3}, "bfloat16": {"logit_plain_tok": 34.75, "logit_spec_tok": 35.25, "margin_plain_minus_spec": -0.5, "top1": "玛丽", "top2_margin": 0.5}, "hf_fp32_matches": "spec"}, {"clip_id": "fleurs_cmn_hans_cn/test/17639585860488007329", "pos": 14, "tok_plain": "铯", "tok_spec": "碘", "hf_fp32_greedy_text": "日本原子能机构表示，核电站检测出了放射性物质，碘和碘。", "float32": {"logit_plain_tok": 22.536, "logit_spec_tok": 22.653, "margin_plain_minus_spec": -0.117, "top1": "碘", "top2_margin": 0.117}, "bfloat16": {"logit_plain_tok": 22.5, "logit_spec_tok": 22.625, "margin_plain_minus_spec": -0.125, "top1": "碘", "top2_margin": 0.125}, "hf_fp32_matches": "spec"}, {"clip_id": "fleurs_ja_jp/test/10362598397973084151", "pos": 31, "tok_plain": "交", "tok_spec": "皮", "hf_fp32_greedy_text": "復興努力に対するリベラル派からの批判では、ワシントンの内部関係者と思われる人物と復興契約を皮かしたことに焦点を当てています。", "float32": {"logit_plain_tok": 21.065, "logit_spec_tok": 21.84, "margin_plain_minus_spec": -0.775, "top1": "皮", "top2_margin": 0.775}, "bfloat16": {"logit_plain_tok": 20.875, "logit_spec_tok": 21.75, "margin_plain_minus_spec": -0.875, "top1": "皮", "top2_margin": 0.875}, "hf_fp32_matches": "spec"}, {"clip_id": "fleurs_ja_jp/test/3746529859942317950", "pos": 7, "tok_plain": "世代", "tok_spec": "、", "hf_fp32_greedy_text": "組分けと組み換えは世代ごとに2つのプールの間を行き来しながら変位をシャッフルします。", "float32": {"logit_plain_tok": 32.019, "logit_spec_tok": 31.015, "margin_plain_minus_spec": 1.004, "top1": "世代", "top2_margin": 1.004}, "bfloat16": {"logit_plain_tok": 32.0, "logit_spec_tok": 31.0, "margin_plain_minus_spec": 1.0, "top1": "世代", "top2_margin": 1.0}, "hf_fp32_matches": "plain"}, {"clip_id": "librispeech/test.other/1688-142285-0049", "pos": 9, "tok_plain": ",\"", "tok_spec": ".", "hf_fp32_greedy_text": "I had forgotten what I said for the time. Continued Margaret quietly.", "float32": {"logit_plain_tok": 37.692, "logit_spec_tok": 38.589, "margin_plain_minus_spec": -0.897, "top1": ".", "top2_margin": 0.897}, "bfloat16": {"logit_plain_tok": 37.75, "logit_spec_tok": 38.5, "margin_plain_minus_spec": -0.75, "top1": ".", "top2_margin": 0.75}, "hf_fp32_matches": "spec"}, {"clip_id": "librispeech/test.other/2609-156975-0038", "pos": 30, "tok_plain": " and", "tok_spec": " in", "hf_fp32_greedy_text": "The constant necessity of meeting the dangers of the wilderness, and the defending the flocks entrusted to Moses' care, developed his courage and power of leadership and action.", "float32": {"logit_plain_tok": 42.911, "logit_spec_tok": 42.761, "margin_plain_minus_spec": 0.149, "top1": " and", "top2_margin": 0.149}, "bfloat16": {"logit_plain_tok": 43.0, "logit_spec_tok": 42.5, "margin_plain_minus_spec": 0.5, "top1": " and", "top2_margin": 0.5}, "hf_fp32_matches": "plain"}, {"clip_id": "librispeech/test.other/4198-12259-0008", "pos": 46, "tok_plain": ".", "tok_spec": ";", "hf_fp32_greedy_text": "If I drink not, I am a ground, dry, gravelled and spent. I am stark dead without drink, and my soul ready to fly into some marsh amongst frogs. The soul never dwells in a dry place. Drought killeth it", "float32": {"logit_plain_tok": 39.202, "logit_spec_tok": 39.198, "margin_plain_minus_spec": 0.003, "top1": ".", "top2_margin": 0.003}, "bfloat16": {"logit_plain_tok": 39.25, "logit_spec_tok": 39.25, "margin_plain_minus_spec": 0.0, "top1": ";", "top2_margin": 0.0}, "hf_fp32_matches": "plain"}, {"clip_id": "librispeech/test.other/8280-266249-0016", "pos": 25, "tok_plain": ".", "tok_spec": ",", "hf_fp32_greedy_text": "The half dozen cigars which most smokers use a day, contain six or seven grains, enough if concentrated and absorbed to kill three men, and a pound of tobacco, according to its quality, contains from ", "float32": {"logit_plain_tok": 42.316, "logit_spec_tok": 42.302, "margin_plain_minus_spec": 0.015, "top1": ".", "top2_margin": 0.015}, "bfloat16": {"logit_plain_tok": 42.0, "logit_spec_tok": 42.0, "margin_plain_minus_spec": 0.0, "top1": ".", "top2_margin": 0.0}, "hf_fp32_matches": "plain"}]}